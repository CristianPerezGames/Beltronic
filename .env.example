# Dónde se guardan los datos:
#   local    -> navegador (localStorage). Por defecto.
#   api      -> API REST genérica (ej. json-server, o tu propio backend)
#   supabase -> Base de datos PostgreSQL en Supabase
VITE_STORAGE=local

# Para VITE_STORAGE=api
VITE_API_URL=http://localhost:3001
VITE_API_TOKEN=

# Para VITE_STORAGE=supabase
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_KEY=TU_ANON_KEY

# Formato de moneda
VITE_CURRENCY=COP
VITE_CURRENCY_DECIMALS=0
VITE_LOCALE=es-CO

# Meses de compras y ventas que se cargan al abrir la app
VITE_HISTORIAL_MESES=12
